{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterScript",
  "version": "0.6.5",
  "identifier": "com.masterscript.desktop",
  "mainBinaryName": "masterscript",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MasterScript",
        "width": 1600,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximized": true,
        "visible": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost wss://signaling.yjs.dev; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "MasterScript desktop screenwriting suite",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/migration-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxODQ0NEZFOENCQ0Y4NDAKUldSQStMeU0va1NFd1NHZDlxL1QxWmdYamp0S3dDNGtJMUVFOE5PS1VrZDREamRkaVJsTmpSRGsK",
      "endpoints": [
        "https://github.com/Srimanthl2k6/Masterscript/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
