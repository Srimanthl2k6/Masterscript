{
  "name": "masterscript",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Srimanthl2k6/Masterscript.git"
  },
  "scripts": {
    "dev": "npm run dev:desktop",
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:desktop": "concurrently -k -n web,electron -c cyan,magenta \"npm run dev:web\" \"npm run dev:electron\"",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:desktop": "npm run build:web && electron-builder",
    "parity:generate": "node analysis/parity/generate-parity-artifacts.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.masterscript.desktop",
    "productName": "MasterScript",
    "icon": "icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Srimanthl2k6",
        "repo": "Masterscript"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "docx": "^9.6.1",
    "electron-updater": "^6.8.3",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5"
  }
}
