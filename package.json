{
  "name": "masterscript",
  "private": true,
  "version": "0.7.0",
  "description": "MasterScript desktop screenwriting suite",
  "author": "Srimanthl2k6",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Srimanthl2k6/Masterscript.git"
  },
  "scripts": {
    "dev": "npm run tauri:dev",
    "dev:web": "vite",
    "dev:desktop": "npm run tauri:dev",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:desktop": "npm run tauri:build",
    "benchmark:fixtures": "tsx scripts/performance/generate-fixtures.ts",
    "benchmark:bundle": "npm run build:web && node scripts/performance/measure-bundle.mjs",
    "benchmark:tauri": "tsx scripts/performance/capture-tauri-runtime.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "parity:generate": "node analysis/parity/generate-parity-artifacts.mjs",
    "security:audit": "node scripts/security/audit-gate.mjs",
    "security:exceptions": "node scripts/security/validate-advisory-exceptions.mjs",
    "security:settings": "node scripts/security/verify-repository-settings.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "build:tui-domain": "node scripts/tui/build-domain.mjs",
    "build:tui": "npm run build:tui-domain && node scripts/tui/prepare-bundle.mjs",
    "test:tui": "npm run build:tui-domain && cargo test --locked --manifest-path tui/Cargo.toml",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "docx": "^9.7.1",
    "mammoth": "^1.12.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "y-indexeddb": "9.0.12",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "rolldown": "^1.2.8",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
